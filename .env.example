# OCI model and endpoint settings
GENAI_MODEL=xai.grok-4.6
REGION=us-chicago-1

# DAC
# GENAI_MODEL=ocid1.generativeaiendpoint.oc1.uk-london-1.replace-me
# REGION=uk-london-1

COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me

##### (!!) The values below are working per default, you do not need to change them ####

# IANA timezone used to interpret relative holiday dates (for example, tomorrow).
TIMEZONE=America/Los_Angeles
# TIMEZONE=Europe/Brussels

# API_KEY uses the usual OCI SDK configuration (~/.oci/config). Other supported
# authentication modes can be supplied as appropriate for langchain-oci.
AUTH_TYPE=API_KEY

# OpenWeather current-conditions API key. Keep this value out of source control.
# OPENWEATHER_API_KEY=(sample)a828a80b2188ff682d6e2c65c6e693da
OPENWEATHER_API_KEY=replace-me

# Langfuse tracing settings
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=http://12.34.56.78
